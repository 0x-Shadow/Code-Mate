STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
# LemonSqueezy (legacy, optional)
LEMON_SQUEEZY_WEBHOOK_SECRET=
