# Code executor (Piston-compatible). The public emkc.org endpoint is
# whitelist-only — self-host in one command and put your URL here:
#   docker run -d -p 2000:2000 ghcr.io/engineer-man/piston
#   NEXT_PUBLIC_PISTON_URL=http://YOUR-SERVER:2000/api/v2/piston/execute
NEXT_PUBLIC_PISTON_URL=

# Google AdSense — get it from https://www.google.com/adsense (after they
# approve your domain). Empty = placeholder boxes, no ad scripts loaded.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional per-placement ad-unit IDs (AdSense → Ads → Ad units). Empty = Auto Ads fill.
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_BOTTOM=
